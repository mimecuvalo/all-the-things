{
  "name": "all-the-things",
  "private": true,
  "description": "all the bells 🔔 and whistles 😙 for TanStack Start",
  "repository": {
    "type": "git",
    "url": "https://github.com/mimecuvalo/all-the-things.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.22.1"
  },
  "bugs": {
    "url": "https://github.com/mimecuvalo/all-the-things/issues"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n:extract": "formatjs extract 'app/routes/**/*.ts*' 'components/**/*.ts*' --out-file i18n/en.json --additional-component-names F --id-interpolation-pattern '[md5:contenthash:hex:10]' --flatten --format smartling",
    "i18n:compile": "formatjs compile-folder i18n i18n/compiled --format smartling --ast",
    "config": "node scripts/config.js",
    "prepare": "husky",
    "prisma:generate": "prisma generate",
    "test": "vitest",
    "test:ci": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@fontsource/noto-color-emoji": "5.3.0",
    "@hono/zod-validator": "0.9.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@radix-ui/react-icons": "1.3.2",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "classnames": "2.5.1",
    "hono": "4.12.31",
    "intl-messageformat": "11.2.12",
    "pg": "8.22.0",
    "prisma": "7.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intl": "10.1.18",
    "sanitize.css": "13.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@formatjs/cli": "6.16.14",
    "@formatjs/unplugin": "1.2.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "axe-core": "4.12.1",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "17.1.1",
    "nitro": "3.0.260610-beta",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "oxfmt"
    ],
    "**/*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "bash -c 'bun run i18n:extract && bun run i18n:compile'"
    ],
    "prisma/schema.prisma": [
      "bun run prisma:generate"
    ]
  },
  "husky": {
    "hooks": {
      "post-checkout": "./scripts/post-checkout",
      "post-merge": "./scripts/post-merge"
    }
  },
  "browserslist": "last 2 versions",
  "sideEffects": false,
  "packageManager": "bun@1.3.14"
}
